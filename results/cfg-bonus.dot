digraph bonus {
    graph [label="CFG: DataFlowTargets.bonus()", labelloc=t, fontsize=18];
    node [shape=box, style="rounded", fontsize=10];
    edge [fontsize=9];

    start [shape=oval, label="Start"];
    n31 [label="31: bonus(attendance, threshold)"];
    n32 [label="32: attendance == null || threshold < 0"];
    n33 [label="33: throw IllegalArgumentException"];
    n35 [label="35: present = 0"];
    n36 [label="36: streak = 0"];
    n37 [label="37: best = 0"];
    n38 [label="38: for (int a : attendance)"];
    n39 [label="39: a > 0"];
    n40 [label="40: present = present + 1"];
    n41 [label="41: streak = streak + 1"];
    n42 [label="42: streak > best"];
    n43 [label="43: best = streak"];
    n45 [label="45: else"];
    n46 [label="46: streak = 0"];
    n49 [label="49: score = 0"];
    n50 [label="50: present >= threshold"];
    n51 [label="51: score = 5"];
    n53 [label="53: best >= 5"];
    n54 [label="54: score = score + 3"];
    n56 [label="56: return score"];
    end [shape=oval, label="End"];

    start -> n31;
    n31 -> n32;

    n32 -> n33 [label="T: nullAttendance()\nnegativeThreshold()"];
    n32 -> n35 [label="F: emptyAttendanceThresholdZero()\nemptyAttendanceThresholdOne()"];
    n33 -> end;

    n35 -> n36;
    n36 -> n37;
    n37 -> n38;

    n38 -> n39 [label="next: onePositiveAttendance()\nstreakReset()\nscatteredAttendance()\nfiveConsecutiveBelowThreshold()"];
    n38 -> n49 [label="exit: emptyAttendanceThresholdZero()\nemptyAttendanceThresholdOne()"];

    n39 -> n40 [label="T: onePositiveAttendance()\nstreakReset()\nscatteredAttendance()\nfiveConsecutiveBelowThreshold()"];
    n39 -> n45 [label="F: streakReset()\nscatteredAttendance()"];

    n40 -> n41;
    n41 -> n42;

    n42 -> n43 [label="T: onePositiveAttendance()\nfiveConsecutiveBelowThreshold()"];
    n42 -> n38 [label="F: streakReset()"];

    n43 -> n38;
    n45 -> n46;
    n46 -> n38;

    n49 -> n50;

    n50 -> n51 [label="T: bonusAllDefsCoversEveryDefinition()\nemptyAttendanceThresholdZero()\nonePositiveAttendance()"];
    n50 -> n53 [label="F: scoreZeroDefinitionReachesReturn()\nfiveConsecutiveBelowThreshold()"];

    n51 -> n53;

    n53 -> n54 [label="T: bonusAllDefsCoversEveryDefinition()\nfiveConsecutiveBelowThreshold()"];
    n53 -> n56 [label="F: emptyAttendanceThresholdOne()\nonePositiveAttendance()"];

    n54 -> n56;
    n56 -> end;
}
